<Window x:Class="RaceIngenior.SessionReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Session report — Race Ingenior"
        Width="820"
        Height="720"
        MinWidth="640"
        MinHeight="520"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="True"
        FontFamily="Bahnschrift, Segoe UI"
        Topmost="True">

  <Window.Resources>
    <Style x:Key="WecButton" TargetType="Button">
      <Setter Property="Background" Value="#1A1A1A"/>
      <Setter Property="Foreground" Value="#FFFFFF"/>
      <Setter Property="BorderBrush" Value="#444444"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="12,8"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    Padding="{TemplateBinding Padding}"
                    SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#E10600"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="#E10600"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#B00500"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="WecButtonGhost" TargetType="Button" BasedOn="{StaticResource WecButton}">
      <Setter Property="Background" Value="#111111"/>
      <Setter Property="BorderBrush" Value="#555555"/>
    </Style>

    <Style x:Key="Meta" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#888888"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,0,0,2"/>
    </Style>
    <Style x:Key="Value" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#F2F2F2"/>
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#FFFFFF"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Margin" Value="10,0,0,0"/>
    </Style>
    <Style x:Key="TimingCell" TargetType="Border">
      <Setter Property="Background" Value="#000000"/>
      <Setter Property="BorderBrush" Value="#1F1F1F"/>
      <Setter Property="BorderThickness" Value="0,0,1,1"/>
      <Setter Property="Padding" Value="12,10"/>
    </Style>
  </Window.Resources>

  <Border Background="#0A0A0A" BorderBrush="#2A2A2A" BorderThickness="1" SnapsToDevicePixels="True">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="36"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- Title bar -->
      <Grid Grid.Row="0" Background="#000000" MouseLeftButtonDown="Header_OnMouseLeftButtonDown">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="6"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Rectangle Grid.Column="0" Fill="#E10600"/>
        <TextBlock Grid.Column="1" Text="FIA WEC  ·  SESSION REPORT" Foreground="#FFFFFF"
                   FontSize="12" FontWeight="Bold" VerticalAlignment="Center" Margin="10,0,0,0"/>
        <TextBlock Grid.Column="2" Text="{Binding ReportId}" Foreground="#666666"
                   FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" Margin="16,0,12,0"
                   TextTrimming="CharacterEllipsis" HorizontalAlignment="Right"/>
        <Button Grid.Column="3" Content="✕" Click="Close_Click" Width="36" Height="28"
                Margin="0,0,4,0" Cursor="Hand" Background="Transparent"
                Foreground="#AAAAAA" BorderThickness="0" FontSize="14" FontWeight="Bold"/>
      </Grid>

      <!-- Championship strip -->
      <Border Grid.Row="1" Background="#121212" BorderBrush="#1F1F1F" BorderThickness="0,0,0,1" Padding="16,14">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Border Width="4" Background="#E10600" Margin="0,0,14,0"/>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="{Binding HeaderTrack}" Foreground="#FFFFFF" FontSize="22" FontWeight="Bold"
                       TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="{Binding HeaderCar}" Foreground="#CCCCCC" FontSize="13" FontWeight="SemiBold"
                       Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="{Binding HeaderMeta}" Foreground="#888888" FontSize="11" FontWeight="SemiBold"
                       Margin="0,6,0,0"/>
          </StackPanel>
          <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="16,0,0,0">
            <TextBlock Text="PLACE" Foreground="#888888" FontSize="10" FontWeight="SemiBold"
                       HorizontalAlignment="Right"/>
            <TextBlock Text="{Binding Place}" Foreground="#E10600" FontSize="16" FontWeight="Bold"
                       HorizontalAlignment="Right" Margin="0,2,0,0"/>
          </StackPanel>
        </Grid>
      </Border>

      <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Background="#0A0A0A" Padding="12">
        <StackPanel>
          <!-- SESSION -->
          <Border Background="#121212" BorderBrush="#2A2A2A" BorderThickness="1" Margin="0,0,0,10">
            <StackPanel>
              <Grid Background="#000000" Height="28">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="6"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Rectangle Fill="#E10600"/>
                <TextBlock Grid.Column="1" Style="{StaticResource SectionTitle}" Text="SESSION"/>
              </Grid>
              <UniformGrid Columns="3">
                <Border Style="{StaticResource TimingCell}">
                  <StackPanel>
                    <TextBlock Style="{StaticResource Meta}" Text="DRIVER"/>
                    <TextBlock Style="{StaticResource Value}" Text="{Binding Driver}" Margin="0"/>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource TimingCell}">
                  <StackPanel>
                    <TextBlock Style="{StaticResource Meta}" Text="TYPE"/>
                    <TextBlock Style="{StaticResource Value}" Text="{Binding SessionType}" Margin="0"/>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource TimingCell}">
                  <StackPanel>
                    <TextBlock Style="{StaticResource Meta}" Text="DURATION"/>
                    <TextBlock Style="{StaticResource Value}" Text="{Binding Duration}" Margin="0"/>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource TimingCell}">
                  <StackPanel>
                    <TextBlock Style="{StaticResource Meta}" Text="BEST LAP"/>
                    <TextBlock Style="{StaticResource Value}" Text="{Binding BestLap}" Margin="0"/>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource TimingCell}">
                  <StackPanel>
                    <TextBlock Style="{StaticResource Meta}" Text="LAST LAP"/>
                    <TextBlock Style="{StaticResource Value}" Text="{Binding LastLap}" Margin="0"/>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource TimingCell}">
                  <StackPanel>
                    <TextBlock Style="{StaticResource Meta}" Text="ENDED"/>
                    <TextBlock Style="{StaticResource Value}" Text="{Binding Ended}" Margin="0"/>
                  </StackPanel>
                </Border>
              </UniformGrid>
            </StackPanel>
          </Border>

          <!-- TYRES -->
          <Border Background="#121212" BorderBrush="#2A2A2A" BorderThickness="1" Margin="0,0,0,10">
            <StackPanel>
              <Grid Background="#000000" Height="28">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="6"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Rectangle Fill="#E10600"/>
                <TextBlock Grid.Column="1" Style="{StaticResource SectionTitle}" Text="TYRES"/>
              </Grid>
              <UniformGrid Columns="2">
                <Border Style="{StaticResource TimingCell}">
                  <StackPanel>
                    <TextBlock Style="{StaticResource Meta}" Text="COMPOUND"/>
                    <TextBlock Style="{StaticResource Value}" Text="{Binding Compound}" Margin="0"/>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource TimingCell}">
                  <StackPanel>
                    <TextBlock Style="{StaticResource Meta}" Text="PUNCTURE"/>
                    <TextBlock Style="{StaticResource Value}" Text="{Binding Puncture}" Margin="0"/>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource TimingCell}">
                  <StackPanel>
                    <TextBlock Style="{StaticResource Meta}" Text="WEAR START (REMAINING)"/>
                    <TextBlock Style="{StaticResource Value}" Text="{Binding WearStart}" FontSize="13" Margin="0"/>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource TimingCell}">
                  <StackPanel>
                    <TextBlock Style="{StaticResource Meta}" Text="WEAR END (REMAINING)"/>
                    <TextBlock Style="{StaticResource Value}" Text="{Binding WearEnd}" FontSize="13" Margin="0"/>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource TimingCell}">
                  <StackPanel>
                    <TextBlock Style="{StaticResource Meta}" Text="CARCASS MIN"/>
                    <TextBlock Style="{StaticResource Value}" Text="{Binding CarcassMin}" FontSize="13" Margin="0"/>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource TimingCell}">
                  <StackPanel>
                    <TextBlock Style="{StaticResource Meta}" Text="CARCASS MAX"/>
                    <TextBlock Style="{StaticResource Value}" Text="{Binding CarcassMax}" FontSize="13" Margin="0"/>
                  </StackPanel>
                </Border>
              </UniformGrid>
              <Border Style="{StaticResource TimingCell}">
                <StackPanel>
                  <TextBlock Style="{StaticResource Meta}" Text="WARMUP"/>
                  <TextBlock Style="{StaticResource Value}" Text="{Binding Warmup}" FontSize="13" Margin="0,0,0,4"/>
                  <TextBlock Text="{Binding WarmupNotes}" Foreground="#888888" FontSize="11" TextWrapping="Wrap"/>
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>

          <!-- FUEL / ENERGY -->
          <Border Background="#121212" BorderBrush="#2A2A2A" BorderThickness="1" Margin="0,0,0,10">
            <StackPanel>
              <Grid Background="#000000" Height="28">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="6"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Rectangle Fill="#E10600"/>
                <TextBlock Grid.Column="1" Style="{StaticResource SectionTitle}" Text="FUEL / VIRTUAL ENERGY"/>
              </Grid>
              <UniformGrid Columns="1">
                <Border Style="{StaticResource TimingCell}">
                  <StackPanel>
                    <TextBlock Style="{StaticResource Meta}" Text="FUEL"/>
                    <TextBlock Style="{StaticResource Value}" Text="{Binding Fuel}" Margin="0"/>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource TimingCell}">
                  <StackPanel>
                    <TextBlock Style="{StaticResource Meta}" Text="VIRTUAL ENERGY (HYPERCAR)"/>
                    <TextBlock Style="{StaticResource Value}" Text="{Binding VirtualEnergy}" Margin="0"/>
                  </StackPanel>
                </Border>
              </UniformGrid>
            </StackPanel>
          </Border>

          <!-- TEMPS + WEATHER -->
          <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="10"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#121212" BorderBrush="#2A2A2A" BorderThickness="1">
              <StackPanel>
                <Grid Background="#000000" Height="28">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Rectangle Fill="#E10600"/>
                  <TextBlock Grid.Column="1" Style="{StaticResource SectionTitle}" Text="TEMPERATURES"/>
                </Grid>
                <Border Style="{StaticResource TimingCell}">
                  <StackPanel>
                    <TextBlock Style="{StaticResource Meta}" Text="TRACK"/>
                    <TextBlock Style="{StaticResource Value}" Text="{Binding TrackTemps}" FontSize="12" Margin="0,0,0,10"/>
                    <TextBlock Style="{StaticResource Meta}" Text="AIR"/>
                    <TextBlock Style="{StaticResource Value}" Text="{Binding AirTemps}" FontSize="12" Margin="0"/>
                  </StackPanel>
                </Border>
              </StackPanel>
            </Border>

            <Border Grid.Column="2" Background="#121212" BorderBrush="#2A2A2A" BorderThickness="1">
              <StackPanel>
                <Grid Background="#000000" Height="28">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Rectangle Fill="#E10600"/>
                  <TextBlock Grid.Column="1" Style="{StaticResource SectionTitle}" Text="WEATHER / FLAGS"/>
                </Grid>
                <Border Style="{StaticResource TimingCell}">
                  <StackPanel>
                    <TextBlock Style="{StaticResource Meta}" Text="CONDITIONS"/>
                    <TextBlock Style="{StaticResource Value}" Text="{Binding Weather}" FontSize="13" Margin="0,0,0,10"/>
                    <TextBlock Style="{StaticResource Meta}" Text="SUGGESTED COMPOUND"/>
                    <TextBlock Style="{StaticResource Value}" Text="{Binding SuggestedCompound}" Margin="0,0,0,10"/>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                      </Grid.ColumnDefinitions>
                      <StackPanel>
                        <TextBlock Style="{StaticResource Meta}" Text="FCY"/>
                        <TextBlock Style="{StaticResource Value}" Text="{Binding FlagFcy}" Margin="0"/>
                      </StackPanel>
                      <StackPanel Grid.Column="1">
                        <TextBlock Style="{StaticResource Meta}" Text="LOCAL YELLOW"/>
                        <TextBlock Style="{StaticResource Value}" Text="{Binding FlagLocal}" Margin="0"/>
                      </StackPanel>
                      <StackPanel Grid.Column="2">
                        <TextBlock Style="{StaticResource Meta}" Text="BLUE"/>
                        <TextBlock Style="{StaticResource Value}" Text="{Binding FlagBlue}" Margin="0"/>
                      </StackPanel>
                    </Grid>
                  </StackPanel>
                </Border>
              </StackPanel>
            </Border>
          </Grid>
        </StackPanel>
      </ScrollViewer>

      <Border Grid.Row="3" Background="#000000" Padding="12,10" BorderBrush="#1F1F1F" BorderThickness="0,1,0,0">
        <DockPanel>
          <TextBlock x:Name="PathText" DockPanel.Dock="Left"
                     Foreground="#555555" FontSize="10" TextWrapping="Wrap"
                     VerticalAlignment="Center" Margin="0,0,12,0"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Style="{StaticResource WecButtonGhost}" Content="OPEN FOLDER"
                    Click="OpenFolder_Click" Margin="0,0,8,0" Padding="14,8"/>
            <Button Style="{StaticResource WecButton}" Content="CLOSE"
                    Click="Close_Click" IsCancel="True" IsDefault="True" Padding="16,8"/>
          </StackPanel>
        </DockPanel>
      </Border>
    </Grid>
  </Border>
</Window>
