<Window x:Class="RaceIngenior.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings — Race Ingenior"
        Width="560"
        Height="640"
        MinWidth="480"
        MinHeight="480"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontFamily="Bahnschrift, Segoe UI"
        Topmost="True">

  <Window.Resources>
    <Style x:Key="Meta" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#888888"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,0,0,2"/>
    </Style>
    <Style x:Key="WecButton" TargetType="Button">
      <Setter Property="Background" Value="#1A1A1A"/>
      <Setter Property="Foreground" Value="#FFFFFF"/>
      <Setter Property="BorderBrush" Value="#444444"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="12,8"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    Padding="{TemplateBinding Padding}"
                    SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#E10600"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="#E10600"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#B00500"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="WecButtonGhost" TargetType="Button" BasedOn="{StaticResource WecButton}">
      <Setter Property="Background" Value="#111111"/>
      <Setter Property="Foreground" Value="#F2F2F2"/>
      <Setter Property="BorderBrush" Value="#555555"/>
    </Style>
    <Style x:Key="WecComboItem" TargetType="ComboBoxItem">
      <Setter Property="Background" Value="#161616"/>
      <Setter Property="Foreground" Value="#F2F2F2"/>
      <Setter Property="Padding" Value="8,5"/>
      <Style.Triggers>
        <Trigger Property="IsHighlighted" Value="True">
          <Setter Property="Background" Value="#E10600"/>
          <Setter Property="Foreground" Value="#FFFFFF"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="WecCombo" TargetType="ComboBox">
      <Setter Property="Background" Value="#161616"/>
      <Setter Property="Foreground" Value="#F2F2F2"/>
      <Setter Property="BorderBrush" Value="#444444"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="8,6"/>
      <Setter Property="MinHeight" Value="32"/>
      <Setter Property="ItemContainerStyle" Value="{StaticResource WecComboItem}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <ToggleButton Focusable="False" ClickMode="Press"
                            IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Chrome" Background="#161616" BorderBrush="#444444" BorderThickness="1">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="28"/>
                        </Grid.ColumnDefinitions>
                        <Path Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                              Data="M 0 0 L 8 0 L 4 5 Z" Fill="#F2F2F2"/>
                      </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Chrome" Property="BorderBrush" Value="#E10600"/>
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <ContentPresenter IsHitTestVisible="False" Margin="10,6,32,6"
                                VerticalAlignment="Center" HorizontalAlignment="Left"
                                Content="{TemplateBinding SelectionBoxItem}"
                                ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}">
                <ContentPresenter.Resources>
                  <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="#F2F2F2"/>
                    <Setter Property="Margin" Value="0"/>
                  </Style>
                </ContentPresenter.Resources>
              </ContentPresenter>
              <Popup Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                     AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                <Border MinWidth="{TemplateBinding ActualWidth}"
                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                        Background="#161616" BorderBrush="#444444" BorderThickness="1" Margin="0,2,0,0">
                  <ScrollViewer Margin="2">
                    <StackPanel IsItemsHost="True"/>
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="WecTextBox" TargetType="TextBox">
      <Setter Property="Background" Value="#161616"/>
      <Setter Property="Foreground" Value="#F2F2F2"/>
      <Setter Property="BorderBrush" Value="#444444"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="8,6"/>
      <Setter Property="CaretBrush" Value="#F2F2F2"/>
      <Setter Property="SelectionBrush" Value="#E10600"/>
    </Style>
  </Window.Resources>

  <Border Background="#121212"
          BorderBrush="#2A2A2A"
          BorderThickness="1"
          SnapsToDevicePixels="True">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="36"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <Grid Grid.Row="0" Background="#0A0A0A" MouseLeftButtonDown="Header_OnMouseLeftButtonDown">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="6"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Rectangle Grid.Column="0" Fill="#E10600"/>
        <TextBlock Grid.Column="1"
                   Text="SETTINGS"
                   Foreground="#FFFFFF"
                   FontSize="13"
                   FontWeight="Bold"
                   VerticalAlignment="Center"
                   Margin="10,0,0,0"/>
        <TextBlock Grid.Column="2"
                   Text="RACE INGENIOR"
                   Foreground="#AAAAAA"
                   FontSize="11"
                   FontWeight="SemiBold"
                   VerticalAlignment="Center"
                   Margin="12,0,12,0"/>
        <Button Grid.Column="3"
                Content="✕"
                Click="Close_Click"
                Width="36" Height="28"
                Margin="0,0,4,0"
                Cursor="Hand"
                Background="Transparent"
                Foreground="#AAAAAA"
                BorderThickness="0"
                FontSize="14"
                FontWeight="Bold"
                ToolTip="Close"/>
      </Grid>

      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16,14"
                    Background="#000000">
        <StackPanel>
          <TextBlock Style="{StaticResource Meta}" Text="PTT DEVICE"/>
          <DockPanel Margin="0,0,0,10">
            <Button DockPanel.Dock="Right" Style="{StaticResource WecButtonGhost}" Content="REFRESH"
                    Command="{Binding RefreshDevicesCommand}" Margin="8,0,0,0" Padding="10,6"/>
            <ComboBox Style="{StaticResource WecCombo}"
                      ItemsSource="{Binding PttDevices}"
                      SelectedItem="{Binding SelectedDevice}"
                      DisplayMemberPath="Name"/>
          </DockPanel>

          <TextBlock Style="{StaticResource Meta}" Text="PTT BUTTON"/>
          <DockPanel Margin="0,0,0,4">
            <Button DockPanel.Dock="Right" Style="{StaticResource WecButtonGhost}"
                    Content="{Binding LearnButtonLabel}"
                    Command="{Binding ToggleLearnPttCommand}" Margin="8,0,0,0" Padding="10,6"/>
            <ComboBox Style="{StaticResource WecCombo}"
                      ItemsSource="{Binding ButtonIndexes}"
                      SelectedItem="{Binding SelectedButtonIndex}"/>
          </DockPanel>
          <Button Style="{StaticResource WecButton}" Content="SAVE PTT BINDING"
                  Command="{Binding SavePttBindingCommand}"
                  HorizontalAlignment="Left" Margin="0,0,0,8"/>
          <CheckBox Content="PTT radio beeps (open / close)"
                    IsChecked="{Binding PttBeepEnabled}"
                    Foreground="#F2F2F2" Margin="0,0,0,16"
                    ToolTip="Short tones when you press and release Push-to-Talk (open beep plays before the mic starts)"/>

          <Border BorderBrush="#333333" BorderThickness="0,1,0,0" Padding="0,14,0,0" Margin="0,0,0,16">
            <StackPanel>
              <TextBlock Text="RADIO VOICE" Foreground="#E10600" FontSize="11" FontWeight="Bold" Margin="0,0,0,8"/>
              <TextBlock Style="{StaticResource Meta}" Text="VOICE"/>
              <ComboBox Style="{StaticResource WecCombo}" Margin="0,0,0,4"
                        ItemsSource="{Binding TtsVoices}"
                        SelectedItem="{Binding SelectedTtsVoice}"
                        DisplayMemberPath="DisplayName"/>
              <TextBlock Text="Neural = Gemini (needs API key). Windows = offline fallback."
                         Foreground="#666666" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12"/>
              <TextBlock Style="{StaticResource Meta}" Text="SPEECH RATE"/>
              <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding SpeechRateLabel}"
                           Foreground="#F2F2F2" VerticalAlignment="Center" MinWidth="72" FontWeight="Bold"/>
                <Slider Minimum="-10" Maximum="10" TickFrequency="1" IsSnapToTickEnabled="True"
                        Value="{Binding SpeechRate, Mode=TwoWay}" VerticalAlignment="Center"/>
              </DockPanel>
            </StackPanel>
          </Border>

          <TextBlock Style="{StaticResource Meta}" Text="OVERLAY"/>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
            <CheckBox Content="Click-through" IsChecked="{Binding OverlayClickThrough}"
                      VerticalAlignment="Center" Foreground="#F2F2F2" Margin="0,0,16,0"/>
            <CheckBox Content="Force show" IsChecked="{Binding OverlayForceShow}"
                      VerticalAlignment="Center" Foreground="#F2F2F2" Margin="0,0,16,0"
                      ToolTip="Keep tyre + radio overlays visible (ignore pit/pause/no data) for testing and placement"/>
            <TextBlock Text="Radio toast" Foreground="#AAAAAA" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox Style="{StaticResource WecCombo}" Width="72"
                      ItemsSource="{Binding ConversationOverlayDurations}"
                      SelectedItem="{Binding ConversationOverlaySeconds}"/>
            <TextBlock Text="s" Foreground="#AAAAAA" VerticalAlignment="Center" Margin="6,0,0,0"/>
          </StackPanel>
          <TextBlock Text="Force show keeps both overlays up for layout. Turn click-through off to drag / scale. Tyre card auto-hides in box / pause; radio toast lasts 5–10 s."
                     Foreground="#777777" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,16"/>

          <TextBlock Style="{StaticResource Meta}" Text="SESSION REPORTS"/>
          <CheckBox Content="Automatically open end-of-session report"
                    IsChecked="{Binding AutoOpenSessionReport}"
                    Foreground="#F2F2F2" Margin="0,0,0,6"
                    ToolTip="When a live session ends, open the WEC session report board"/>
          <TextBlock Text="Browse past reports via REPORTS on the dashboard. Files: Reports/ and %LocalAppData%\RaceIngenior\Reports."
                     Foreground="#777777" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,16"/>

          <TextBlock Style="{StaticResource Meta}" Text="SESSION MEMORY"/>
          <TextBlock Text="{Binding MemoryStatus}" Foreground="#AAAAAA" FontSize="11" Margin="0,0,0,6"/>
          <Button Style="{StaticResource WecButtonGhost}" Content="CLEAR MEMORY"
                  Command="{Binding ClearMemoryCommand}"
                  HorizontalAlignment="Left" Margin="0,0,0,16"/>

          <TextBlock Style="{StaticResource Meta}" Text="GEMINI API KEY"/>
          <TextBlock Text="{Binding GeminiStatus}" Foreground="#AAAAAA" FontSize="11"
                     TextWrapping="Wrap" Margin="0,0,0,6"/>
          <TextBox Style="{StaticResource WecTextBox}"
                   Text="{Binding GeminiApiKeyInput, UpdateSourceTrigger=PropertyChanged}"
                   FontSize="12"
                   Margin="0,0,0,6"
                   ToolTip="Paste your Google AI Studio key, then Save. Stored in local user settings."/>
          <WrapPanel Margin="0,0,0,4">
            <Button Style="{StaticResource WecButton}" Content="SAVE KEY" Command="{Binding SaveGeminiApiKeyCommand}" Margin="0,0,8,0"/>
            <Button Style="{StaticResource WecButtonGhost}" Content="CLEAR KEY" Command="{Binding ClearGeminiApiKeyCommand}" Margin="0,0,8,0"/>
            <Button Style="{StaticResource WecButtonGhost}" Content="TEST GEMINI" Command="{Binding TestGeminiCommand}"/>
          </WrapPanel>
          <TextBlock Text="Saved in %LocalAppData%\RaceIngenior — no need to edit app files."
                     Foreground="#777777" FontSize="10" TextWrapping="Wrap"/>
        </StackPanel>
      </ScrollViewer>

      <Border Grid.Row="2" Background="#0A0A0A" Padding="12,10">
        <Button Style="{StaticResource WecButtonGhost}"
                Content="CLOSE"
                Click="Close_Click"
                HorizontalAlignment="Right"
                Padding="16,8"
                IsCancel="True"
                IsDefault="True"/>
      </Border>
    </Grid>
  </Border>
</Window>
