<Window x:Class="RaceIngenior.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        xmlns:controls="clr-namespace:RaceIngenior.Controls"
        Title="Race Ingenior — WEC"
        Height="780" Width="1280"
        MinHeight="640" MinWidth="1180"
        Background="#0A0A0A"
        Foreground="#F2F2F2"
        FontFamily="Bahnschrift, Segoe UI"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized">

  <Window.Resources>
    <Style x:Key="Meta" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#888888"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,0,0,2"/>
    </Style>
    <Style x:Key="Value" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#F2F2F2"/>
      <Setter Property="FontSize" Value="18"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#FFFFFF"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Margin" Value="10,0,0,0"/>
    </Style>
    <Style x:Key="WecButton" TargetType="Button">
      <Setter Property="Background" Value="#1A1A1A"/>
      <Setter Property="Foreground" Value="#FFFFFF"/>
      <Setter Property="BorderBrush" Value="#444444"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="12,8"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    Padding="{TemplateBinding Padding}"
                    SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#E10600"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="#E10600"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#B00500"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="WecButtonGhost" TargetType="Button" BasedOn="{StaticResource WecButton}">
      <Setter Property="Background" Value="#111111"/>
      <Setter Property="Foreground" Value="#F2F2F2"/>
      <Setter Property="BorderBrush" Value="#555555"/>
    </Style>
    <Style x:Key="WecButtonDanger" TargetType="Button" BasedOn="{StaticResource WecButton}">
      <Setter Property="Background" Value="#E10600"/>
      <Setter Property="BorderBrush" Value="#E10600"/>
    </Style>
    <Style x:Key="WecComboItem" TargetType="ComboBoxItem">
      <Setter Property="Background" Value="#161616"/>
      <Setter Property="Foreground" Value="#F2F2F2"/>
      <Setter Property="Padding" Value="8,5"/>
      <Style.Triggers>
        <Trigger Property="IsHighlighted" Value="True">
          <Setter Property="Background" Value="#E10600"/>
          <Setter Property="Foreground" Value="#FFFFFF"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="WecCombo" TargetType="ComboBox">
      <Setter Property="Background" Value="#161616"/>
      <Setter Property="Foreground" Value="#F2F2F2"/>
      <Setter Property="BorderBrush" Value="#444444"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="8,6"/>
      <Setter Property="MinHeight" Value="32"/>
      <Setter Property="ItemContainerStyle" Value="{StaticResource WecComboItem}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <ToggleButton Focusable="False" ClickMode="Press"
                            IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Chrome" Background="#161616" BorderBrush="#444444" BorderThickness="1">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="28"/>
                        </Grid.ColumnDefinitions>
                        <Path Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                              Data="M 0 0 L 8 0 L 4 5 Z" Fill="#F2F2F2"/>
                      </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Chrome" Property="BorderBrush" Value="#E10600"/>
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <ContentPresenter IsHitTestVisible="False" Margin="10,6,32,6"
                                VerticalAlignment="Center" HorizontalAlignment="Left"
                                Content="{TemplateBinding SelectionBoxItem}"
                                ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}">
                <ContentPresenter.Resources>
                  <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="#F2F2F2"/>
                    <Setter Property="Margin" Value="0"/>
                  </Style>
                </ContentPresenter.Resources>
              </ContentPresenter>
              <Popup Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                     AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                <Border MinWidth="{TemplateBinding ActualWidth}"
                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                        Background="#161616" BorderBrush="#444444" BorderThickness="1" Margin="0,2,0,0">
                  <ScrollViewer Margin="2">
                    <StackPanel IsItemsHost="True"/>
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="44"/>
      <RowDefinition Height="28"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="26"/>
    </Grid.RowDefinitions>

    <!-- Championship header -->
    <Grid Grid.Row="0" Background="#000000">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="6"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <Rectangle Grid.Column="0" Fill="#E10600"/>
      <TextBlock Grid.Column="1" Text="WEC" Foreground="#FFFFFF" FontSize="18" FontWeight="Bold"
                 VerticalAlignment="Center" Margin="14,0,0,0"/>
      <TextBlock Grid.Column="2" Text="RACE INGENIOR" Foreground="#AAAAAA" FontSize="13" FontWeight="SemiBold"
                 VerticalAlignment="Center" Margin="14,0,0,0"/>
      <TextBlock Grid.Column="3" Text="{Binding AppVersion, StringFormat={}v{0}}" Foreground="#666666" FontSize="11"
                 FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0,0,0"
                 ToolTip="Application version"/>
      <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
        <Button Style="{StaticResource WecButtonGhost}" Content="RECORDS"
                Click="Records_Click" Margin="0,0,8,0" Padding="10,6"/>
        <Button Style="{StaticResource WecButtonGhost}" Content="REPORTS"
                Click="Reports_Click" Margin="0,0,8,0" Padding="10,6"/>
        <Button Style="{StaticResource WecButtonGhost}" Content="SETTINGS"
                Click="Settings_Click" Margin="0,0,8,0" Padding="10,6"/>
        <Button Style="{StaticResource WecButtonGhost}" Content="{Binding OverlayToggleLabel}"
                Command="{Binding ToggleOverlayCommand}" Margin="0,0,8,0" Padding="10,6"/>
        <Button Style="{StaticResource WecButtonDanger}" Content="RESTART"
                Command="{Binding RestartAppCommand}" Padding="12,6"/>
      </StackPanel>
    </Grid>

    <!-- Status line -->
    <Grid Grid.Row="1" Background="#141414">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" BorderBrush="#2A2A2A" BorderThickness="0,0,1,0" Padding="12,0">
        <TextBlock Text="{Binding ConnectionStatus}" Foreground="#DDDDDD" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
      </Border>
      <Border Grid.Column="1" BorderBrush="#2A2A2A" BorderThickness="0,0,1,0" Padding="12,0">
        <TextBlock Text="{Binding GeminiStatus}" Foreground="#AAAAAA" VerticalAlignment="Center" FontSize="11" TextTrimming="CharacterEllipsis"/>
      </Border>
      <Border Grid.Column="2" BorderBrush="#2A2A2A" BorderThickness="0,0,1,0" Padding="12,0">
        <TextBlock Text="{Binding MemoryStatus}" Foreground="#AAAAAA" VerticalAlignment="Center" FontSize="11"/>
      </Border>
      <Border Grid.Column="3" Padding="12,0">
        <TextBlock Text="{Binding PttStatus}" Foreground="#AAAAAA" VerticalAlignment="Center" FontSize="11" TextTrimming="CharacterEllipsis"/>
      </Border>
    </Grid>

    <!-- Main boards -->
    <Grid Grid.Row="2" Margin="12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1.05*"/>
        <ColumnDefinition Width="12"/>
        <ColumnDefinition Width="0.95*"/>
        <ColumnDefinition Width="12"/>
        <ColumnDefinition Width="0.9*"/>
      </Grid.ColumnDefinitions>

      <!-- TELEMETRY + TRACK MAP -->
      <Grid Grid.Column="0">
        <Grid.RowDefinitions>
          <RowDefinition Height="1.05*"/>
          <RowDefinition Height="10"/>
          <RowDefinition Height="0.95*"/>
          <RowDefinition Height="10"/>
          <RowDefinition Height="0.72*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#121212" BorderBrush="#2A2A2A" BorderThickness="1">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="28"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Background="#000000">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Rectangle Fill="#E10600"/>
              <TextBlock Grid.Column="1" Style="{StaticResource SectionTitle}" Text="TELEMETRY"/>
            </Grid>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="14">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                  <TextBlock Style="{StaticResource Meta}" Text="TRACK"/>
                  <TextBlock Style="{StaticResource Value}" Text="{Binding Track}"/>
                  <TextBlock Style="{StaticResource Meta}" Text="CAR"/>
                  <TextBlock Style="{StaticResource Value}" Text="{Binding Vehicle}"/>
                  <TextBlock Style="{StaticResource Meta}" Text="POSITION / LAP"/>
                  <TextBlock Style="{StaticResource Value}" Text="{Binding Place}"/>
                  <TextBlock Style="{StaticResource Meta}" Text="SPEED / RPM"/>
                  <TextBlock Style="{StaticResource Value}" Text="{Binding Speed}"/>
                  <TextBlock Style="{StaticResource Meta}" Text="FUEL"/>
                  <TextBlock Style="{StaticResource Value}" Text="{Binding Fuel}"/>
                  <TextBlock Style="{StaticResource Meta}" Text="LAP TIMES"/>
                  <TextBlock Style="{StaticResource Value}" Text="{Binding LastLap}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                  <TextBlock Style="{StaticResource Meta}" Text="SESSION"/>
                  <TextBlock Style="{StaticResource Value}" Text="{Binding Phase}"/>
                  <TextBlock Style="{StaticResource Meta}" Text="TRACK TEMP"/>
                  <TextBlock Style="{StaticResource Value}" Text="{Binding WeatherTrackTemp}"/>
                  <TextBlock Style="{StaticResource Meta}" Text="AIR TEMP"/>
                  <TextBlock Style="{StaticResource Value}" Text="{Binding WeatherAmbientTemp}"/>
                  <TextBlock Style="{StaticResource Meta}" Text="FLAGS"/>
                  <TextBlock Text="{Binding FlagStatus}" FontSize="18" FontWeight="Bold" Margin="0,0,0,2">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="#22C55E"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding FlagStatus}" Value="FCY">
                            <Setter Property="Foreground" Value="#F5D000"/>
                          </DataTrigger>
                          <DataTrigger Binding="{Binding FlagStatus}" Value="YELLOW">
                            <Setter Property="Foreground" Value="#F5D000"/>
                          </DataTrigger>
                          <DataTrigger Binding="{Binding FlagStatus}" Value="LOCAL YELLOW">
                            <Setter Property="Foreground" Value="#F5D000"/>
                          </DataTrigger>
                          <DataTrigger Binding="{Binding FlagStatus}" Value="BLUE">
                            <Setter Property="Foreground" Value="#2E7DFF"/>
                          </DataTrigger>
                          <DataTrigger Binding="{Binding FlagStatus}" Value="RED / STOP">
                            <Setter Property="Foreground" Value="#E10600"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                  <TextBlock Text="{Binding FlagDetail}" Foreground="#AAAAAA" FontSize="12" Margin="0,0,0,10" TextWrapping="Wrap"/>
                  <TextBlock Style="{StaticResource Meta}" Text="VIRTUAL ENERGY"/>
                  <TextBlock Style="{StaticResource Value}" Text="{Binding Energy}"/>
                  <TextBlock Style="{StaticResource Meta}" Text="TYRE REMAINING"/>
                  <TextBlock Style="{StaticResource Value}" Text="{Binding Tires}" FontSize="14"/>
                  <TextBlock Style="{StaticResource Meta}" Text="TYRE CARCASS"/>
                  <TextBlock Style="{StaticResource Value}" Text="{Binding TireCarcass}" FontSize="14"/>
                  <TextBlock Style="{StaticResource Meta}" Text="TYRE SURFACE"/>
                  <TextBlock Style="{StaticResource Value}" Text="{Binding TireTemps}" FontSize="14"/>
                </StackPanel>
              </Grid>
            </ScrollViewer>
          </Grid>
        </Border>

        <Border Grid.Row="2" Background="#121212" BorderBrush="#2A2A2A" BorderThickness="1">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="28"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Background="#000000">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <Rectangle Fill="#E10600"/>
              <TextBlock Grid.Column="1" Style="{StaticResource SectionTitle}" Text="TRACK MAP"/>
              <TextBlock Grid.Column="2" Text="{Binding TrackMapModeLabel}"
                         Foreground="#666666" FontSize="10" FontWeight="SemiBold"
                         VerticalAlignment="Center" Margin="0,0,12,0"
                         ToolTip="LEARNED = outline from Tracks/*.json · OVAL = temporary fallback"/>
            </Grid>
            <Border Grid.Row="1"
                    Background="Transparent"
                    Cursor="Hand"
                    ToolTip="Click to enlarge track map"
                    MouseLeftButtonUp="TrackMap_OnMouseLeftButtonUp">
              <controls:TrackMapControl Cars="{Binding TrackCars}"
                                        Layout="{Binding CurrentTrackLayout}"
                                        StatusMessage="{Binding TrackMapStatus}"
                                        Margin="4"/>
            </Border>
          </Grid>
        </Border>

        <Border Grid.Row="4" Background="#121212" BorderBrush="#2A2A2A" BorderThickness="1">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="28"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Background="#000000">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <Rectangle Fill="#E10600"/>
              <TextBlock Grid.Column="1" Style="{StaticResource SectionTitle}" Text="TYRE CALL"/>
              <TextBlock Grid.Column="2" Text="{Binding TireConditionLabel}"
                         FontSize="10" FontWeight="Bold"
                         VerticalAlignment="Center" Margin="0,0,12,0">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="#E10600"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding TireRecommended}" Value="SOFT">
                        <Setter Property="Foreground" Value="#FFFFFF"/>
                      </DataTrigger>
                      <DataTrigger Binding="{Binding TireRecommended}" Value="MEDIUM">
                        <Setter Property="Foreground" Value="#F5D000"/>
                      </DataTrigger>
                      <DataTrigger Binding="{Binding TireRecommended}" Value="HARD">
                        <Setter Property="Foreground" Value="#E10600"/>
                      </DataTrigger>
                      <DataTrigger Binding="{Binding TireRecommended}" Value="WET">
                        <Setter Property="Foreground" Value="#2E7DFF"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </Grid>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="12,10">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="14"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#000000" BorderBrush="#2A2A2A" BorderThickness="1"
                        Padding="14,10" MinWidth="110" VerticalAlignment="Top">
                  <StackPanel>
                    <TextBlock Text="FIT" Foreground="#888888" FontSize="10" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding TireRecommended}"
                               FontSize="26" FontWeight="Bold" Margin="0,2,0,0">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Setter Property="Foreground" Value="#AAAAAA"/>
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding TireRecommended}" Value="SOFT">
                              <Setter Property="Foreground" Value="#FFFFFF"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding TireRecommended}" Value="MEDIUM">
                              <Setter Property="Foreground" Value="#F5D000"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding TireRecommended}" Value="HARD">
                              <Setter Property="Foreground" Value="#E10600"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding TireRecommended}" Value="WET">
                              <Setter Property="Foreground" Value="#2E7DFF"/>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                    <Border Height="4" Margin="0,8,0,0" CornerRadius="1">
                      <Border.Style>
                        <Style TargetType="Border">
                          <Setter Property="Background" Value="#444444"/>
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding TireRecommended}" Value="SOFT">
                              <Setter Property="Background" Value="#FFFFFF"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding TireRecommended}" Value="MEDIUM">
                              <Setter Property="Background" Value="#F5D000"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding TireRecommended}" Value="HARD">
                              <Setter Property="Background" Value="#E10600"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding TireRecommended}" Value="WET">
                              <Setter Property="Background" Value="#2E7DFF"/>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Border.Style>
                    </Border>
                    <TextBlock Text="ON CAR" Foreground="#666666" FontSize="9" FontWeight="SemiBold" Margin="0,10,0,2"/>
                    <TextBlock Text="{Binding TireFitted}" Foreground="#AAAAAA" FontSize="12" TextWrapping="Wrap"/>
                  </StackPanel>
                </Border>

                <StackPanel Grid.Column="2">
                  <TextBlock Text="{Binding TireAdviceReason}" Foreground="#F2F2F2"
                             FontSize="13" TextWrapping="Wrap" Margin="0,0,0,10"/>
                  <UniformGrid Columns="2">
                    <StackPanel Margin="0,0,8,8">
                      <TextBlock Style="{StaticResource Meta}" Text="TRACK TEMP"/>
                      <TextBlock Text="{Binding WeatherTrackTemp}" Foreground="#F2F2F2" FontSize="15" FontWeight="Bold"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,0,8">
                      <TextBlock Style="{StaticResource Meta}" Text="AMBIENT"/>
                      <TextBlock Text="{Binding WeatherAmbientTemp}" Foreground="#F2F2F2" FontSize="15" FontWeight="Bold"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,8,0">
                      <TextBlock Style="{StaticResource Meta}" Text="RAIN"/>
                      <TextBlock Text="{Binding WeatherRain}" Foreground="#F2F2F2" FontSize="15" FontWeight="Bold"/>
                    </StackPanel>
                    <StackPanel>
                      <TextBlock Style="{StaticResource Meta}" Text="PATH WETNESS"/>
                      <TextBlock Text="{Binding WeatherWetness}" Foreground="#F2F2F2" FontSize="13" FontWeight="Bold" TextWrapping="Wrap"/>
                    </StackPanel>
                  </UniformGrid>
                  <TextBlock Margin="0,8,0,0" Foreground="#666666" FontSize="10" TextWrapping="Wrap"
                             Text="Windows: Soft ≤15°C · Medium 15–25°C · Hard &gt;25°C · Wet if damp/rain."/>
                  <TextBlock Margin="0,4,0,0" Foreground="#555555" FontSize="10"
                             Text="{Binding WeatherCloud, StringFormat=Cloud cover: {0}}"/>
                </StackPanel>
              </Grid>
            </ScrollViewer>
          </Grid>
        </Border>
      </Grid>

      <!-- STANDINGS -->
      <Border Grid.Column="2" Background="#121212" BorderBrush="#2A2A2A" BorderThickness="1">
        <controls:StandingsPanel/>
      </Border>

      <!-- RADIO CARD -->
      <Border Grid.Column="4" Background="#121212" BorderBrush="#2A2A2A" BorderThickness="1">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="28"/>
            <RowDefinition Height="1.55*"/>
            <RowDefinition Height="28"/>
            <RowDefinition Height="0.75*"/>
          </Grid.RowDefinitions>

          <Grid Grid.Row="0" Background="#000000">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="6"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Rectangle Fill="#E10600"/>
            <TextBlock Grid.Column="1" Style="{StaticResource SectionTitle}" Text="RADIO"/>
            <TextBlock Grid.Column="2" Text="{Binding RadioMode}" Foreground="#E10600"
                       FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,12,0"/>
          </Grid>

          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="14">
            <StackPanel>
              <TextBlock Text="PTT, speech, overlay and Gemini key live in Settings."
                         Foreground="#777777" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12"/>

              <Border Background="#000000" BorderBrush="#2A2A2A" BorderThickness="1" Padding="10" Margin="0,0,0,10">
                <StackPanel>
                  <DockPanel Margin="0,0,0,2">
                    <Button DockPanel.Dock="Right" Style="{StaticResource WecButtonGhost}"
                            Command="{Binding CopyLastExchangeCommand}" Padding="8,5" Margin="8,0,0,0"
                            VerticalAlignment="Center" ToolTip="Copy last exchange">
                      <Path Width="12" Height="14" Stretch="Uniform" Fill="#F2F2F2"
                            Data="M4,2 H10 A2,2 0 0 1 12,4 V12 A2,2 0 0 1 10,14 H4 A2,2 0 0 1 2,12 V4 A2,2 0 0 1 4,2 Z M6,0 H12 A2,2 0 0 1 14,2 V10 H12 V2 H6 Z"/>
                    </Button>
                    <TextBlock Text="DRIVER" Foreground="#E10600" FontSize="10" FontWeight="Bold"
                               VerticalAlignment="Center"/>
                  </DockPanel>
                  <TextBlock Text="{Binding LastDriver}" Foreground="#F2F2F2" TextWrapping="Wrap" Margin="0,2,0,8" MinHeight="18"/>
                  <TextBlock Text="ENGINEER" Foreground="#E10600" FontSize="10" FontWeight="Bold"/>
                  <TextBlock Text="{Binding LastEngineer}" Foreground="#F2F2F2" TextWrapping="Wrap" Margin="0,2,0,0" MinHeight="18"/>
                </StackPanel>
              </Border>

              <Button Style="{StaticResource WecButton}" Content="TEST RADIO" Command="{Binding TestRadioCommand}"
                      HorizontalAlignment="Left"/>
            </StackPanel>
          </ScrollViewer>

          <Grid Grid.Row="2" Background="#000000">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="6"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Rectangle Fill="#E10600"/>
            <TextBlock Grid.Column="1" Style="{StaticResource SectionTitle}" Text="RADIO LOG"/>
          </Grid>

          <ListBox Grid.Row="3"
                   ItemsSource="{Binding LogLines}"
                   Background="#0E0E0E"
                   Foreground="#CCCCCC"
                   BorderThickness="0"
                   FontSize="11"
                   Padding="6"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
        </Grid>
      </Border>
    </Grid>

    <!-- Footer -->
    <Grid Grid.Row="3" Background="#000000">
      <TextBlock Text="HOLD WHEEL PTT TO TALK  ·  LE MANS ULTIMATE"
                 Foreground="#777777" FontSize="10" FontWeight="SemiBold"
                 VerticalAlignment="Center" HorizontalAlignment="Center"/>
    </Grid>

    <tb:TaskbarIcon x:Name="TrayIcon"
                    Grid.Row="0"
                    ToolTipText="Race Ingenior"
                    Visibility="Collapsed"
                    MenuActivation="RightClick"
                    TrayMouseDoubleClick="TrayIcon_OnTrayMouseDoubleClick">
      <tb:TaskbarIcon.ContextMenu>
        <ContextMenu>
          <MenuItem Header="Show dashboard" Click="Show_Click"/>
          <MenuItem Header="Track records" Click="Records_Click"/>
          <MenuItem Header="Session reports" Click="Reports_Click"/>
          <MenuItem Header="Settings" Click="Settings_Click"/>
          <MenuItem Header="Hide to tray" Click="Hide_Click"/>
          <MenuItem Header="Toggle overlays" Click="Overlay_Click"/>
          <MenuItem Header="Restart app" Click="Restart_Click"/>
          <Separator/>
          <MenuItem Header="Exit" Click="Exit_Click"/>
        </ContextMenu>
      </tb:TaskbarIcon.ContextMenu>
