<Window x:Class="RaceIngenior.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WEC carcass overlay"
        SizeToContent="WidthAndHeight"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        FontFamily="Bahnschrift, Segoe UI"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        MouseWheel="Window_MouseWheel">

  <!-- Dashboard-aligned dark plate: #0A0A0A / #121212, red mark, Bahnschrift -->
  <Border x:Name="Root"
          Background="#121212"
          BorderBrush="#2A2A2A"
          BorderThickness="1"
          SnapsToDevicePixels="True"
          MinWidth="236">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="28"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="26"/>
      </Grid.RowDefinitions>

      <!-- Championship header -->
      <Grid Grid.Row="0" Background="#0A0A0A">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="6"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Rectangle Grid.Column="0" Fill="#E10600"/>
        <TextBlock Grid.Column="1"
                   Text="WEC"
                   Foreground="#FFFFFF"
                   FontSize="13"
                   FontWeight="Bold"
                   VerticalAlignment="Center"
                   Margin="8,0,0,0"/>
        <TextBlock Grid.Column="2"
                   Text="TYRES"
                   Foreground="#AAAAAA"
                   FontSize="11"
                   FontWeight="SemiBold"
                   VerticalAlignment="Center"
                   Margin="10,0,0,0"/>
        <TextBlock Grid.Column="3"
                   Text="°C"
                   Foreground="#E10600"
                   FontSize="11"
                   FontWeight="Bold"
                   VerticalAlignment="Center"
                   Margin="0,0,10,0"/>
      </Grid>

      <!-- Fuel / delta strip -->
      <Grid Grid.Row="1" Background="#000000" Height="22">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0"
                   Text="{Binding Fuel}"
                   Foreground="#F2F2F2"
                   FontSize="11"
                   FontWeight="SemiBold"
                   VerticalAlignment="Center"
                   Margin="10,0,0,0"/>
        <Rectangle Grid.Column="1" Width="1" Fill="#2A2A2A"/>
        <TextBlock Grid.Column="2"
                   Text="{Binding Delta}"
                   Foreground="{Binding DeltaBrush}"
                   FontSize="11"
                   FontWeight="Bold"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Right"
                   Margin="0,0,10,0"/>
      </Grid>

      <!-- 2x2 timing cells -->
      <Grid Grid.Row="2" Margin="0" MinHeight="120">
        <Grid.RowDefinitions>
          <RowDefinition Height="*"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Rectangle Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                   Height="1" Fill="#2A2A2A" VerticalAlignment="Bottom"/>
        <Rectangle Grid.Row="0" Grid.Column="0" Grid.RowSpan="2"
                   Width="1" Fill="#2A2A2A" HorizontalAlignment="Right"/>

        <Border Grid.Row="0" Grid.Column="0" Padding="10,8">
          <StackPanel>
            <TextBlock Text="FL" Foreground="#777777" FontSize="10" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding Fl}"
                       Foreground="{Binding FlBrush}"
                       FontSize="34"
                       FontWeight="Bold"
                       Margin="0,-2,0,0"/>
          </StackPanel>
        </Border>
        <Border Grid.Row="0" Grid.Column="1" Padding="10,8">
          <StackPanel>
            <TextBlock Text="FR" Foreground="#777777" FontSize="10" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding Fr}"
                       Foreground="{Binding FrBrush}"
                       FontSize="34"
                       FontWeight="Bold"
                       Margin="0,-2,0,0"/>
          </StackPanel>
        </Border>
        <Border Grid.Row="1" Grid.Column="0" Padding="10,8">
          <StackPanel>
            <TextBlock Text="RL" Foreground="#777777" FontSize="10" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding Rl}"
                       Foreground="{Binding RlBrush}"
                       FontSize="34"
                       FontWeight="Bold"
                       Margin="0,-2,0,0"/>
          </StackPanel>
        </Border>
        <Border Grid.Row="1" Grid.Column="1" Padding="10,8">
          <StackPanel>
            <TextBlock Text="RR" Foreground="#777777" FontSize="10" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding Rr}"
                       Foreground="{Binding RrBrush}"
                       FontSize="34"
                       FontWeight="Bold"
                       Margin="0,-2,0,0"/>
          </StackPanel>
        </Border>
      </Grid>

      <!-- Status strip -->
      <Border Grid.Row="3" Background="{Binding StatusBrush}">
        <TextBlock Text="{Binding Status}"
                   Foreground="{Binding StatusForeground}"
                   FontSize="11"
                   FontWeight="Bold"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center"/>
      </Border>
    </Grid>
  </Border>
</Window>
