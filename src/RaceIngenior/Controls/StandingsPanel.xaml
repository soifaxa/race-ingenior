<UserControl x:Class="RaceIngenior.Controls.StandingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#121212">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="28"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <Grid Grid.Row="0" Background="#000000">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="6"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <Rectangle Fill="#E10600"/>
      <TextBlock Grid.Column="1" Text="STANDINGS" Foreground="#FFFFFF"
                 FontSize="12" FontWeight="Bold" VerticalAlignment="Center" Margin="10,0,0,0"/>
      <TextBlock Grid.Column="2" Text="{Binding StandingsCountLabel}"
                 Foreground="#666666" FontSize="10" FontWeight="SemiBold"
                 VerticalAlignment="Center" Margin="0,0,12,0"
                 ToolTip="Cars in the live field"/>
    </Grid>
    <Grid Grid.Row="1" Background="#0A0A0A" Margin="0" Height="22">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="28"/>
        <ColumnDefinition Width="4"/>
        <ColumnDefinition Width="32"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="44"/>
        <ColumnDefinition Width="72"/>
        <ColumnDefinition Width="72"/>
        <ColumnDefinition Width="64"/>
        <ColumnDefinition Width="40"/>
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" Text="P" Foreground="#555555" FontSize="9" FontWeight="Bold"
                 VerticalAlignment="Center" HorizontalAlignment="Center"/>
      <TextBlock Grid.Column="2" Text="MFR" Foreground="#555555" FontSize="9" FontWeight="Bold"
                 VerticalAlignment="Center" HorizontalAlignment="Center"/>
      <TextBlock Grid.Column="3" Text="DRIVER" Foreground="#555555" FontSize="9" FontWeight="Bold"
                 VerticalAlignment="Center" Margin="6,0,0,0"/>
      <TextBlock Grid.Column="4" Text="CLS" Foreground="#555555" FontSize="9" FontWeight="Bold"
                 VerticalAlignment="Center" HorizontalAlignment="Center"/>
      <TextBlock Grid.Column="5" Text="LAST" Foreground="#555555" FontSize="9" FontWeight="Bold"
                 VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,6,0"/>
      <TextBlock Grid.Column="6" Text="BEST" Foreground="#555555" FontSize="9" FontWeight="Bold"
                 VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,6,0"/>
      <TextBlock Grid.Column="7" Text="GAP" Foreground="#555555" FontSize="9" FontWeight="Bold"
                 VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,6,0"/>
      <TextBlock Grid.Column="8" Text="PIT" Foreground="#555555" FontSize="9" FontWeight="Bold"
                 VerticalAlignment="Center" HorizontalAlignment="Center"/>
    </Grid>
    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Background="#0A0A0A">
      <ItemsControl ItemsSource="{Binding Standings}">
        <ItemsControl.Style>
          <Style TargetType="ItemsControl">
            <Style.Triggers>
              <DataTrigger Binding="{Binding Standings.Count}" Value="0">
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="ItemsControl">
                      <TextBlock Text="Waiting for field data…"
                                 Foreground="#666666" FontSize="12"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"
                                 Margin="16"/>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </ItemsControl.Style>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border BorderBrush="#1A1A1A" BorderThickness="0,0,0,1" Padding="0,5">
              <Border.Style>
                <Style TargetType="Border">
                  <Setter Property="Background" Value="Transparent"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsPlayer}" Value="True">
                      <Setter Property="Background" Value="#1A0A0A"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Border.Style>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="28"/>
                  <ColumnDefinition Width="4"/>
                  <ColumnDefinition Width="32"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="44"/>
                  <ColumnDefinition Width="72"/>
                  <ColumnDefinition Width="72"/>
                  <ColumnDefinition Width="64"/>
                  <ColumnDefinition Width="40"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding PlaceText}"
                           Foreground="#F2F2F2" FontSize="13" FontWeight="Bold"
                           VerticalAlignment="Center" HorizontalAlignment="Center"/>
                <Rectangle Grid.Column="1" Width="3" VerticalAlignment="Stretch">
                  <Rectangle.Style>
                    <Style TargetType="Rectangle">
                      <Setter Property="Fill" Value="#555555"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding ClassKey}" Value="HYPERCAR">
                          <Setter Property="Fill" Value="#E10600"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ClassKey}" Value="LMP2">
                          <Setter Property="Fill" Value="#2E7DFF"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ClassKey}" Value="LMP3">
                          <Setter Property="Fill" Value="#38BDF8"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ClassKey}" Value="LMGT3">
                          <Setter Property="Fill" Value="#22C55E"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Rectangle.Style>
                </Rectangle>
                <!-- Border keeps hit-testing when BrandLogo is null (GT3 without resolved SVG). -->
                <Border Grid.Column="2"
                        Width="24" Height="18"
                        Background="Transparent"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        ToolTip="{Binding BrandHint}"
                        ToolTipService.ShowOnDisabled="True">
                  <Image Source="{Binding BrandLogo}"
                         Stretch="Uniform"
                         RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>
                <TextBlock Grid.Column="3" Text="{Binding Name}"
                           FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                           Margin="6,0,4,0" TextTrimming="CharacterEllipsis">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Foreground" Value="#DDDDDD"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsPlayer}" Value="True">
                          <Setter Property="Foreground" Value="#FFFFFF"/>
                          <Setter Property="FontWeight" Value="Bold"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
                <TextBlock Grid.Column="4" Text="{Binding ClassLabel}"
                           Foreground="#888888" FontSize="10" FontWeight="Bold"
                           VerticalAlignment="Center" HorizontalAlignment="Center"/>
                <TextBlock Grid.Column="5" Text="{Binding LastLap}"
                           Foreground="#F2F2F2" FontSize="11" FontWeight="SemiBold"
                           VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,6,0"/>
                <TextBlock Grid.Column="6" Text="{Binding BestLap}"
                           Foreground="#AAAAAA" FontSize="11" FontWeight="SemiBold"
                           VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,6,0"/>
                <TextBlock Grid.Column="7" Text="{Binding Gap}"
                           FontSize="11" FontWeight="Bold"
                           VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,6,0">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Foreground" Value="#F2F2F2"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Gap}" Value="LEADER">
                          <Setter Property="Foreground" Value="#E10600"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
                <TextBlock Grid.Column="8" Text="{Binding Pit}"
                           FontSize="10" FontWeight="Bold"
                           VerticalAlignment="Center" HorizontalAlignment="Center">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Foreground" Value="#888888"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding InPits}" Value="True">
                          <Setter Property="Foreground" Value="#F5D000"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </Grid>
</UserControl>
