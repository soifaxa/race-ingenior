<Window x:Class="RaceIngenior.ReportsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Session reports — Race Ingenior"
        Width="720"
        Height="560"
        MinWidth="520"
        MinHeight="400"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="True"
        FontFamily="Bahnschrift, Segoe UI"
        Topmost="True">

  <Window.Resources>
    <Style x:Key="WecButton" TargetType="Button">
      <Setter Property="Background" Value="#1A1A1A"/>
      <Setter Property="Foreground" Value="#FFFFFF"/>
      <Setter Property="BorderBrush" Value="#444444"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="12,8"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    Padding="{TemplateBinding Padding}"
                    SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#E10600"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="#E10600"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#B00500"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="WecButtonGhost" TargetType="Button" BasedOn="{StaticResource WecButton}">
      <Setter Property="Background" Value="#111111"/>
      <Setter Property="BorderBrush" Value="#555555"/>
    </Style>
  </Window.Resources>

  <Border Background="#0A0A0A" BorderBrush="#2A2A2A" BorderThickness="1" SnapsToDevicePixels="True">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="36"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <Grid Grid.Row="0" Background="#000000" MouseLeftButtonDown="Header_OnMouseLeftButtonDown">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="6"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Rectangle Grid.Column="0" Fill="#E10600"/>
        <TextBlock Grid.Column="1" Text="FIA WEC  ·  SESSION REPORTS" Foreground="#FFFFFF"
                   FontSize="12" FontWeight="Bold" VerticalAlignment="Center" Margin="10,0,0,0"/>
        <TextBlock Grid.Column="2" Text="{Binding StatusText}" Foreground="#666666"
                   FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"
                   Margin="16,0,12,0" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"/>
        <Button Grid.Column="3" Content="✕" Click="Close_Click" Width="36" Height="28"
                Margin="0,0,4,0" Cursor="Hand" Background="Transparent"
                Foreground="#AAAAAA" BorderThickness="0" FontSize="14" FontWeight="Bold"/>
      </Grid>

      <Border Grid.Row="1" Background="#121212" BorderBrush="#1F1F1F" BorderThickness="0,0,0,1" Padding="12,10">
        <DockPanel>
          <TextBlock DockPanel.Dock="Left" Text="Select a report to open the timing board."
                     Foreground="#888888" FontSize="11" FontWeight="SemiBold"
                     VerticalAlignment="Center"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Style="{StaticResource WecButtonGhost}" Content="REFRESH"
                    Command="{Binding RefreshCommand}" Margin="0,0,8,0" Padding="14,8"/>
            <Button Style="{StaticResource WecButton}" Content="OPEN"
                    Command="{Binding OpenSelectedCommand}"
                    IsEnabled="{Binding HasSelection}"
                    IsDefault="True" Padding="16,8"/>
          </StackPanel>
        </DockPanel>
      </Border>

      <ListBox Grid.Row="2" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}"
               Background="#0A0A0A" BorderThickness="0" Padding="8"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled"
               MouseDoubleClick="List_OnMouseDoubleClick">
        <ListBox.ItemContainerStyle>
          <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                  <Border x:Name="Bd" Background="#121212" BorderBrush="#2A2A2A" BorderThickness="1"
                          Padding="12,10" SnapsToDevicePixels="True">
                    <ContentPresenter/>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="Bd" Property="BorderBrush" Value="#E10600"/>
                    </Trigger>
                    <Trigger Property="IsSelected" Value="True">
                      <Setter TargetName="Bd" Property="Background" Value="#1A0A0A"/>
                      <Setter TargetName="Bd" Property="BorderBrush" Value="#E10600"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Rectangle Grid.Column="0" Fill="#E10600" Margin="0,2,10,2"/>
              <StackPanel Grid.Column="1">
                <TextBlock Text="{Binding TitleLine}" Foreground="#FFFFFF" FontSize="15" FontWeight="Bold"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding MetaLine}" Foreground="#888888" FontSize="11" FontWeight="SemiBold"
                           Margin="0,4,0,0" TextWrapping="Wrap"/>
              </StackPanel>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <Border Grid.Row="3" Background="#000000" Padding="12,10" BorderBrush="#1F1F1F" BorderThickness="0,1,0,0">
        <DockPanel>
          <TextBlock DockPanel.Dock="Left" Foreground="#555555" FontSize="10"
                     Text="Sources: Reports/ · %LocalAppData%\RaceIngenior\Reports"
                     VerticalAlignment="Center"/>
          <Button DockPanel.Dock="Right" Style="{StaticResource WecButtonGhost}" Content="CLOSE"
                  Click="Close_Click" IsCancel="True" HorizontalAlignment="Right" Padding="16,8"/>
        </DockPanel>
      </Border>
    </Grid>
  </Border>
</Window>
