<Window x:Class="RaceIngenior.RecordsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Track records — Race Ingenior"
        Width="760"
        Height="600"
        MinWidth="560"
        MinHeight="420"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="True"
        FontFamily="Bahnschrift, Segoe UI"
        Topmost="True">

  <Window.Resources>
    <Style x:Key="WecButton" TargetType="Button">
      <Setter Property="Background" Value="#1A1A1A"/>
      <Setter Property="Foreground" Value="#FFFFFF"/>
      <Setter Property="BorderBrush" Value="#444444"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="12,8"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    Padding="{TemplateBinding Padding}"
                    SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#E10600"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="#E10600"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#B00500"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="WecButtonGhost" TargetType="Button" BasedOn="{StaticResource WecButton}">
      <Setter Property="Background" Value="#111111"/>
      <Setter Property="BorderBrush" Value="#555555"/>
    </Style>
  </Window.Resources>

  <Border Background="#0A0A0A" BorderBrush="#2A2A2A" BorderThickness="1" SnapsToDevicePixels="True">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="36"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <Grid Grid.Row="0" Background="#000000" MouseLeftButtonDown="Header_OnMouseLeftButtonDown">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="6"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Rectangle Grid.Column="0" Fill="#E10600"/>
        <TextBlock Grid.Column="1" Text="FIA WEC  ·  TRACK RECORDS" Foreground="#FFFFFF"
                   FontSize="12" FontWeight="Bold" VerticalAlignment="Center" Margin="10,0,0,0"/>
        <TextBlock Grid.Column="2" Text="{Binding StatusText}" Foreground="#666666"
                   FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"
                   Margin="16,0,12,0" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"/>
        <Button Grid.Column="3" Content="✕" Click="Close_Click" Width="36" Height="28"
                Margin="0,0,4,0" Cursor="Hand" Background="Transparent"
                Foreground="#AAAAAA" BorderThickness="0" FontSize="14" FontWeight="Bold"/>
      </Grid>

      <Border Grid.Row="1" Background="#121212" BorderBrush="#1F1F1F" BorderThickness="0,0,0,1" Padding="12,10">
        <DockPanel>
          <TextBlock DockPanel.Dock="Left"
                     Text="Personal best lap per track and car (from finished sessions)."
                     Foreground="#888888" FontSize="11" FontWeight="SemiBold"
                     VerticalAlignment="Center" TextWrapping="Wrap"/>
          <Button DockPanel.Dock="Right" Style="{StaticResource WecButtonGhost}" Content="REFRESH"
                  Command="{Binding RefreshCommand}" HorizontalAlignment="Right"
                  Margin="12,0,0,0" Padding="14,8"/>
        </DockPanel>
      </Border>

      <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Background="#0A0A0A" Padding="12">
        <ItemsControl ItemsSource="{Binding Tracks}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Background="#121212" BorderBrush="#2A2A2A" BorderThickness="1" Margin="0,0,0,10">
                <StackPanel>
                  <Grid Background="#000000" Height="28">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="6"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Rectangle Fill="#E10600"/>
                    <TextBlock Grid.Column="1" Text="{Binding TrackName}" Foreground="#FFFFFF"
                               FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="10,0,0,0"/>
                  </Grid>
                  <ItemsControl ItemsSource="{Binding Cars}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border BorderBrush="#1F1F1F" BorderThickness="0,0,0,1" Padding="12,10" Background="#000000">
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="40"/>
                              <ColumnDefinition Width="*"/>
                              <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Image Grid.Column="0"
                                   Source="{Binding BrandLogo}"
                                   Width="28" Height="20"
                                   Stretch="Uniform"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Left"
                                   ToolTip="{Binding Brand}"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                              <TextBlock Text="{Binding VehicleName}" Foreground="#F2F2F2"
                                         FontSize="14" FontWeight="Bold" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="16,0,0,0">
                              <TextBlock Text="{Binding BestLap}" Foreground="#E10600"
                                         FontSize="20" FontWeight="Bold" HorizontalAlignment="Right"/>
                              <TextBlock Text="{Binding SetAt}" Foreground="#555555"
                                         FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,2,0,0"/>
                            </StackPanel>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <Border Grid.Row="3" Background="#000000" Padding="12,10" BorderBrush="#1F1F1F" BorderThickness="0,1,0,0">
        <DockPanel>
          <TextBlock DockPanel.Dock="Left" Foreground="#555555" FontSize="10"
                     Text="%LocalAppData%\RaceIngenior\track_records.json"
                     VerticalAlignment="Center"/>
          <Button DockPanel.Dock="Right" Style="{StaticResource WecButtonGhost}" Content="CLOSE"
                  Click="Close_Click" IsCancel="True" IsDefault="True"
                  HorizontalAlignment="Right" Padding="16,8"/>
        </DockPanel>
      </Border>
    </Grid>
  </Border>
</Window>
