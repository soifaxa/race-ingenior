<Window x:Class="RaceIngenior.ConversationOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Radio conversation"
        Width="320"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        FontFamily="Bahnschrift, Segoe UI"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

  <Border Background="#121212"
          BorderBrush="#2A2A2A"
          BorderThickness="1"
          SnapsToDevicePixels="True">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="28"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <Grid Grid.Row="0" Background="#0A0A0A">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="6"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Rectangle Grid.Column="0" Fill="#E10600"/>
        <TextBlock Grid.Column="1"
                   Text="RADIO"
                   Foreground="#FFFFFF"
                   FontSize="13"
                   FontWeight="Bold"
                   VerticalAlignment="Center"
                   Margin="8,0,0,0"/>
        <TextBlock Grid.Column="2"
                   Text="EXCHANGE"
                   Foreground="#AAAAAA"
                   FontSize="11"
                   FontWeight="SemiBold"
                   VerticalAlignment="Center"
                   Margin="10,0,10,0"/>
      </Grid>

      <Border Grid.Row="1" Background="#000000" Margin="1" Padding="12,10">
        <StackPanel>
          <TextBlock Text="DRIVER" Foreground="#E10600" FontSize="10" FontWeight="Bold"/>
          <TextBlock Text="{Binding ConversationDriver}"
                     Foreground="#F2F2F2"
                     FontSize="13"
                     TextWrapping="Wrap"
                     Margin="0,2,0,10"
                     MinHeight="18"/>
          <TextBlock Text="ENGINEER" Foreground="#E10600" FontSize="10" FontWeight="Bold"/>
          <TextBlock Text="{Binding ConversationEngineer}"
                     Foreground="#F2F2F2"
                     FontSize="13"
                     TextWrapping="Wrap"
                     Margin="0,2,0,0"
                     MinHeight="18"/>
        </StackPanel>
      </Border>
    </Grid>
  </Border>
</Window>
